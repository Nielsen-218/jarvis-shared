<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Talks to his own Jarvis only (HTTPS; see res/xml/network_security_config.xml). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The "Allow background running" button asks for the battery-optimisation exemption. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Only for the last-resort "Open in Metrolist" notification when a song could not be started. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Health data (Garmin) through Android Health Connect: READ ONLY, Android 14+ (HealthSync / Hc). Requested only
         when he taps "Allow Jarvis to read health data"; nothing is ever written to Health Connect. -->
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_VO2_MAX" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <!-- Android 15+: read in the background (the link loop syncs every 2 hours) and data older than 30 days. -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" />

    <!-- Package visibility (Android 11+): the only other app this one ever looks at. -->
    <queries>
        <package android:name="com.metrolist.music" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_link"
        android:label="Jarvis Link"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The Jarvis page's "Connect this phone" button: jarvislink://pair?code=...&base=... (MainActivity.handleLink). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="jarvislink" android:host="pair" />
            </intent-filter>
        </activity>

        <!-- The privacy screen Health Connect links to: what is read, where it goes, how to stop. Android 13 and the
             Health Connect app use the rationale action; Android 14+ uses the alias below. -->
        <activity
            android:name=".PrivacyActivity"
            android:exported="true"
            android:label="Jarvis Link: health data">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name=".ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".PrivacyActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Holding Notification access is what lets this app see and control media sessions
             (MediaSessionManager.getActiveSessions). It never reads, stores or sends a notification.
             It also hosts the link loop (LinkEngine): the system keeps it bound while access is granted. -->
        <service
            android:name=".LinkListener"
            android:exported="true"
            android:label="Jarvis Link"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
