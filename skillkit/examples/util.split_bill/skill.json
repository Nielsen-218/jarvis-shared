{
  "format": "jarvis-skill/1",
  "id": "util.split_bill",
  "version": "1.1.0",
  "title": "Split a bill",
  "description": "Splits a restaurant bill plus tip between people to the cent, in exact integer cents.",
  "author": {
    "name": "JARVIS example (hand-written, no AI model needed)",
    "contact": ""
  },
  "scope": "Dividing ONE bill total (0 to 1,000,000 dollars, at most 2 decimal places) with an optional tip percent (0-100, at most 2 decimal places) evenly between 1 to 1000 people. Tip is applied to the pre-tip total, the total with tip is rounded half-up to the cent, leftover cents go one each to the first people. NOT itemised bills, unequal shares, currencies other than dollars, or taxes.",
  "permissions": [
    "compute"
  ],
  "dependencies": {
    "python": ">=3.10",
    "modules": [
      "decimal"
    ]
  },
  "entry": "run",
  "params": {
    "total": {
      "type": "decimal",
      "places": 2,
      "min": 0,
      "max": 1000000,
      "from_text": "\\$\\s*(\\d[\\d,]*(?:\\.\\d+)?)",
      "ask": "How much is the bill, in dollars?"
    },
    "tip_percent": {
      "type": "decimal",
      "places": 2,
      "min": 0,
      "max": 100,
      "from_text": "(\\d+(?:\\.\\d+)?)\\s*(?:%|percent)",
      "default": "0"
    },
    "people": {
      "type": "integer",
      "min": 1,
      "max": 1000,
      "number_words": true,
      "from_text": "(\\d+)\\s*(?:people|ways|persons|friends|guests|of us)",
      "ask": "How many people are splitting it?"
    }
  },
  "triggers": {
    "match": "word",
    "all": [
      [
        "split",
        "divide",
        "splitting"
      ],
      [
        "bill",
        "check",
        "tab",
        "dinner",
        "lunch",
        "tip",
        "ways",
        "evenly"
      ]
    ],
    "exclude": [
      "bill gates",
      "git",
      "commit",
      "pdf",
      "screen",
      "window",
      "windows",
      "video",
      "audio",
      "file",
      "files",
      "rig",
      "bone",
      "string",
      "difference",
      "text",
      "image",
      "list",
      "data",
      "column",
      "table",
      "paragraph",
      "clip",
      "track",
      "partition"
    ]
  },
  "recovery": {
    "zero_total": {
      "ask_user": true,
      "why": "a bill of zero dollars has nothing to split"
    },
    "not_enough_money": {
      "ask_user": true,
      "why": "that is less than one cent per person"
    }
  },
  "errors": {
    "zero_total": "the bill total must be above zero",
    "not_enough_money": "there is less than one cent per person"
  },
  "verify": {
    "invariants": [
      {
        "name": "shares add up to the total",
        "expr": "sum(output['shares_cents']) == output['total_cents']"
      },
      {
        "name": "shares differ by at most one cent",
        "expr": "max(output['shares_cents']) - min(output['shares_cents']) <= 1"
      },
      {
        "name": "one share per person",
        "expr": "len(output['shares_cents']) == input['people']"
      },
      {
        "name": "total equals an independent exact half-up calculation",
        "expr": "output['total_cents'] == int((Decimal(input['total']) * (100 + Decimal(input['tip_percent'])) * 2 + 1) // 2)"
      },
      {
        "name": "shares are whole non-negative cents",
        "expr": "all(isinstance(c, int) and c >= 0 for c in output['shares_cents'])"
      }
    ]
  },
  "reply": "Split ${total_with_tip} (including a {tip_percent}% tip) between {people_text}: {share_text}.",
  "provenance": {
    "created_by": "JARVIS project example",
    "created_with": "hand-written",
    "source_url": "",
    "created": "2026-11-01",
    "notes": "Claimed provenance is informational only; trust comes from the host judge."
  },
