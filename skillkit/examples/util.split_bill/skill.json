    "cases/train.json": "56c5655e7f9b46237ca601c5a388c6d531f7955fe85e6c7f8678cd345c08ae83",
    "docs/README.md": "825d3e8f9c525ea3402f0fc0853cad44b4677dfa405d2304017e046e2404358e",
    "judge.py": "3c424c5ba79964100ea583884a2cd72da8c2445795db057ae22d8923676ebdf6",
