# Jarvis settings. setup.ps1 copies this file to .env (once) and fills in the local brain model.
# Everything below works with NO API keys: the brain runs on your own GPU through Ollama.
# Keys are optional extras that YOU bring from YOUR OWN accounts. Never share your .env with anyone.

# ---------------------------------------------------------------------------------------------------------------
# Brain (local, free, private)
# ---------------------------------------------------------------------------------------------------------------
JARVIS_INTELLIGENCE=local-first
JARVIS_LOCAL_MODEL=qwen3.5:9b
JARVIS_LOCAL_FAST_PROVIDER=ollama
JARVIS_LOCAL_FAST_MODEL=qwen3.5:9b
JARVIS_LOCAL_ADVANCED_MODEL=qwen3.5:9b
JARVIS_LOCAL_VISION_MODEL=qwen3.5:9b
JARVIS_LEARNER_MODEL=qwen3.5:9b
JARVIS_TEACHER_LOCAL=qwen3.5:9b
JARVIS_LOCAL_URL=http://127.0.0.1:11434/v1
JARVIS_OLLAMA_URL=http://127.0.0.1:11434/v1
JARVIS_GATEWAY=on
# 1 = never call a paid cloud API, even if a key is set below. Set to 0 to allow the cloud fallback.
JARVIS_LOCAL_ONLY=1
# Which cloud brain helps when the local model can't: gemini, claude, or off. Only used when JARVIS_LOCAL_ONLY=0.
JARVIS_CLOUD_FALLBACK=off

# This machine is a desktop PC (no laptop server, no phone push unless you set it up)
JARVIS_ROLE=desk
JARVIS_PUSH=off

# ---------------------------------------------------------------------------------------------------------------
# Optional cloud keys (YOUR OWN accounts; leave blank to skip). All of these cost money or have free-tier limits.
# ---------------------------------------------------------------------------------------------------------------
# Google Gemini (has a free tier): https://aistudio.google.com/api-keys
GEMINI_API_KEY=
JARVIS_GEMINI_MODEL=gemini-3.5-flash
# Anthropic Claude (paid): https://console.anthropic.com/
ANTHROPIC_API_KEY=
JARVIS_MODEL=claude-sonnet-5-5
JARVIS_FAST_MODEL=claude-haiku-5-5
JARVIS_EFFORT=low
# Hard monthly cap for cloud spending, in US dollars. Jarvis stops using the cloud once it is reached.
JARVIS_MONTHLY_BUDGET=5
# Movie info (free key): https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# 3D model generation (optional, only if you use the Blender skills)
MESHY_API_KEY=
HYPER3D_API_KEY=
# Telegram bot for phone messages (optional): create a bot with @BotFather
TELEGRAM_BOT_TOKEN=

# ---------------------------------------------------------------------------------------------------------------
# How Jarvis addresses you and sounds
# ---------------------------------------------------------------------------------------------------------------
JARVIS_USER_TITLE=sir
JARVIS_VOICE=en-GB-RyanNeural
JARVIS_VOICE_RATE=+8%
JARVIS_FRENCH_VOICE=fr-FR-RemyMultilingualNeural
JARVIS_KREYOL_VOICE=fr-FR-RemyMultilingualNeural
JARVIS_OTHER_VOICE=en-US-AndrewMultilingualNeural
# Your town for weather and "near me" questions (a town, never a street address)
JARVIS_HOME_CITY=

# ---------------------------------------------------------------------------------------------------------------
# Hearing
# ---------------------------------------------------------------------------------------------------------------
# large-v3-turbo needs an NVIDIA GPU. On CPU only: WHISPER_MODEL=small and WHISPER_DEVICE=cpu
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda
WAKE_THRESHOLD=0.5
JARVIS_FOLLOWUP_SECONDS=30
JARVIS_BARGE_IN_RATIO=2.0
JARVIS_SMART_TURN=off
JARVIS_CAMERA=0

# ---------------------------------------------------------------------------------------------------------------
# Optional extras, OFF by default (see README "Optional pieces")
# ---------------------------------------------------------------------------------------------------------------
# Opt-in skill groups (comma list, or "all"): unreal, gamestudio, homelab, qbittorrent, pcview, missions,
# rigging, charjobs, makechar, blenderskills, dojo, gaming. Example: JARVIS_SKILLS_ON=gaming,rigging
JARVIS_SKILLS_ON=
# Turn any skill group off (same names as the tools\ files), e.g. JARVIS_SKILLS_OFF=military,fitness
JARVIS_SKILLS_OFF=
# Storm/earthquake warnings for pinned places (core/stormwatch.py: edit PLACES for your own towns first)
JARVIS_STORMWATCH=off
# 3D robot companion on the desktop
JARVIS_COMPANION=0
# Watches a Syncthing folder sync between two of your machines
JARVIS_SYNC_WATCH=off
# Self-study and skill practice while the PC is idle (uses the GPU when you're away)
JARVIS_AUTOSTUDY=off
JARVIS_ACQUIRE=off
# A home server (Jellyfin / qBittorrent box on your LAN)
HOMELAB_HOST=
HOMELAB_USER=
JELLYFIN_API_KEY=
QBIT_USER=
QBIT_PASS=
# Wake this PC from your phone (set on an always-on second machine only)
JARVIS_PC_WAKE_MAC=
JARVIS_PC_WAKE_BROADCAST=
